<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="expense"
            type="com.example.expensetracker.model.Expense" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:orientation="vertical">
        <TextView
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense Form"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:padding="20dp"
            android:background="@color/material_dynamic_neutral50"/>
        <androidx.core.widget.NestedScrollView
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#F5F5F5">

                <EditText
                    android:id="@+id/expenseReasonInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Expense reason/description"
                    android:inputType="text"
                    android:text="@{expense.reason}"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/expenseAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount"
                    android:inputType="numberDecimal"
                    android:text="@{expense!=null? String.valueOf(expense.amount):null}"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/expenseCategorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/datePickerButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Date"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</layout>